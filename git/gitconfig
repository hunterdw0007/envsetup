# Shared git config/aliases, included from ~/.gitconfig by lib/git.sh. No identity
# (user.name/email) here on purpose — that's prompted for per-machine, not committed.
[init]
	defaultBranch = main
[pull]
	rebase = false
[color]
	ui = auto
[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	lg = log --graph --abbrev-commit --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(blue)<%an>%Creset'
