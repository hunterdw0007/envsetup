{#- A CHANGELOG.md entry, which is also the release's notes (see .cz.toml and
    .github/scripts/release.sh). Breaking changes are listed once, in their own section
    first, since they decide whether someone can move to this version. commitizen files
    them three ways: a "feat!:"/"fix!:" commit under its type with `breaking` set, a
    "BREAKING CHANGE:" footer under that key, and any other "type!:" (chore!, docs!, ...)
    under no key at all. -#}
{% for entry in tree %}
## {{ entry.version }}{{ " (%s)" % entry.date if entry.date }}
{% set breaking = [] %}
{% for change_key, changes in entry.changes.items() %}
{% for change in changes if change.breaking or change_key in (none, "BREAKING CHANGE") %}
{% if breaking.append(change) %}{% endif %}
{% endfor %}
{% endfor %}
{% if breaking %}

### Breaking changes

{% for change in breaking %}
- {% if change.scope %}**{{ change.scope }}**: {% endif %}{{ change.message | replace("\n", " ") }}
{% endfor %}
{% endif %}
{% for change_key, changes in entry.changes.items() if change_key not in (none, "BREAKING CHANGE") %}
{% set rest = changes | rejectattr("breaking") | list %}
{% if rest %}

### {{ change_key }}

{% for change in rest %}
- {% if change.scope %}**{{ change.scope }}**: {% endif %}{{ change.message | replace("\n", " ") }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
