# The repo's style (AGENTS.md), for editors that read https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.sh,*.json,git/gitconfig}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Signed test data: any edit breaks the signature.
[tests/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
