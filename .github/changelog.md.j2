{#- This template writes a CHANGELOG.md entry.
    The entry is also the release's notes (see .cz.toml and .github/scripts/release.sh).
    The entry lists breaking changes once, first, in their own section.
    They decide whether someone can move to this version.
    commitizen sorts breaking changes in three ways:
    - a "feat!:" or "fix!:" commit goes under its type, with `breaking` set
    - a "BREAKING CHANGE:" footer goes under that key
    - any other "type!:" (chore!, docs!, ...) goes under no key at all -#}
{% for entry in tree %}
## {{ entry.version }}{{ " (%s)" % entry.date if entry.date }}
{% set breaking = [] %}
{% for change_key, changes in entry.changes.items() %}
{% for change in changes if change.breaking or change_key in (none, "BREAKING CHANGE") %}
{% if breaking.append(change) %}{% endif %}
{% endfor %}
{% endfor %}
{% if breaking %}

### Breaking changes

{% for change in breaking %}
- {% if change.scope %}**{{ change.scope }}**: {% endif %}{{ change.message | replace("\n", " ") }}
{% endfor %}
{% endif %}
{% for change_key, changes in entry.changes.items() if change_key not in (none, "BREAKING CHANGE") %}
{% set rest = changes | rejectattr("breaking") | list %}
{% if rest %}

### {{ change_key }}

{% for change in rest %}
- {% if change.scope %}**{{ change.scope }}**: {% endif %}{{ change.message | replace("\n", " ") }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
