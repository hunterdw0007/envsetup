# These are shared git settings and aliases.
# lib/git.sh includes them from ~/.gitconfig.
# This file has no name or email (user.name, user.email) on purpose.
# envsetup asks for them on each machine, and nobody commits them.
# Settings for one machine (hooks path, CA bundle, ...) belong in config.sh.
# These are defaults for every envsetup user.
# docs/shell.md lists the ones that change what git does by default.
[advice]
	statusHints = false
[alias]
	a = add
	ap = add --patch
	# This alias stages every file in the current folder that .gitignore does not exclude.
	# An .env file is an example.
	# Run git s before you commit.
	aa = add .
	b = branch
	ba = branch --all
	c = commit
	ca = commit --amend --no-edit
	ce = commit --amend
	co = checkout
	cp = cherry-pick
	d = diff --output-indicator-new=' ' --output-indicator-old=' '
	ds = diff --output-indicator-new=' ' --output-indicator-old=' ' --staged
	i = init
	l = log --graph --pretty=format:'%C(magenta)%h %C(cyan) %an  %C(yellow)%ar%C(blue)  %D%n%s%n'
	la = log --graph --pretty=format:'%C(magenta)%h %C(cyan) %an  %C(yellow)%ar%C(blue)  %D%n%s%n' --all
	n = checkout -b
	p = push origin HEAD
	pf = push origin HEAD --force-with-lease
	r = reset
	s = status --short
	u = pull
	rb = rebase
	po = reset --soft HEAD^
	sw = switch -c
	su = branch -u origin/main
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -taggerdate
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[fetch]
	prune = true
	all = true
[help]
	autocorrect = prompt
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[commit]
	verbose = true
[status]
	branch = true
	showStash = true
	showUntrackedFiles = all
[log]
	abbrevCommit = true
[color "branch"]
	current = magenta
	local = default
	remote = yellow
	upstream = green
	plain = blue
[color "diff"]
	meta = black bold
	frag = magenta
	context = default
	whitespace = yellow reverse
[credential]
	helper = cache --timeout=3600
[push]
	default = current
[init]
	defaultBranch = main
